# CyPee Sovereign Defense Enclave - Environment Template
PORT=3000
NODE_ENV=development

# Database Configuration (SQLite WAL or PostgreSQL RLS)
DATABASE_URL="file:./dev.db"

# Cryptographic Keys & KMS Custody (Tier-4 Envelope Encryption)
JWT_SECRET="replace-with-64-byte-cryptographic-jwt-secret"
DB_MASTER_ENCRYPTION_KEY="replace-with-high-entropy-master-key-v1"
DB_MASTER_ENCRYPTION_KEY_V2="replace-with-rotated-master-key-v2"
API_KEY="replace-with-a-long-random-api-key"

# Who may run system-wide actions (shred keys, quarantine an app, add a proxy target)
CYPEE_OWNER_EMAILS="you@example.com"
# Registration closes after the first account unless this is true
CYPEE_ALLOW_REGISTRATION=false
# Other sites allowed to call the API (the dashboard itself needs none)
CORS_ORIGINS=
# Show the made-up example attack dossiers
CYPEE_DEMO=false

# Protected Fleet Upstream Endpoints
VGRUVS_URL="http://127.0.0.1:4000"
APP1_URL="http://127.0.0.1:4001"
APP2_URL="http://127.0.0.1:4002"
APP3_URL="http://127.0.0.1:4003"
